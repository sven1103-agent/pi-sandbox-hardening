# No secrets, no rendered policies, no probe output should be committed here.
*.bak
*.bak-*
/tmp/
# Rendered/compiled policies are host-specific and must never be committed.
*.sb
# ...but the hand-maintained, genericised policy fragments in launcher/ ARE
# versioned: they are the deliverable, and they contain no secrets or absolute
# user paths (they use HOME_DIR + the home-literal/home-subpath helpers).
!launcher/*.sb
probe-output*.txt
.env
.env.*
.pi-selftest-probe

# Editor / IDE state. `workspace.xml` in particular records local absolute paths,
# recently-opened sibling repos and run configurations — none of which belong in a
# public repo. (`git add -A` swept these in once; that is why they are listed.)
.idea/
*.iml
.vscode/

# Ad-hoc screenshots dropped in the repo root. Rendered figures used as evidence
# belong in docs/ (which is tracked); loose ones here are scratch.
/img*.png
/img*.jpg
/screenshot*.png

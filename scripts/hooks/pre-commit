#!/usr/bin/env bash
# Block accidental secret commits in this repo.
#
# NOTE: the previous version used `git diff --cached --name-only -z | xargs -0 -r
# grep ...` and aborted even with NOTHING staged. On BSD/macOS, `-r` only skips
# blank/whitespace input — with `-0` and empty input xargs still invokes grep
# once with no file arguments, grep reads the (empty) pipe, and the exit status
# makes the hook report a false "possible secret staged". Handle the empty case
# explicitly instead of relying on xargs -r.
set -euo pipefail

pat='hf_[A-Za-z0-9]{10,}|gho_[A-Za-z0-9]{10,}|ghp_[A-Za-z0-9]{10,}|github_pat_[A-Za-z0-9_]{10,}|go-keyring-base64:[A-Za-z0-9+/=]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'

# Collect staged paths (NUL-safe); bail out cleanly if there are none.
staged=()
while IFS= read -r -d '' f; do
  staged+=("$f")
done < <(git diff --cached --name-only -z)

if (( ${#staged[@]} == 0 )); then
  exit 0
fi

# Only inspect files that still exist (skip deletions).
files=()
for f in "${staged[@]}"; do
  [[ -f "$f" ]] && files+=("$f")
done
(( ${#files[@]} == 0 )) && exit 0

if grep -InE "$pat" -- "${files[@]}" >/dev/null 2>&1; then
  echo "ERROR: possible secret staged. Commit aborted." >&2
  grep -InE "$pat" -- "${files[@]}" >&2 || true
  exit 1
fi

exit 0
